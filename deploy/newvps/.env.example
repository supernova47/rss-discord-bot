DISCORD_BOT_TOKEN=put-your-bot-token-here
DISCORD_CLIENT_ID=put-your-application-client-id-here
DISCORD_CLIENT_SECRET=put-your-oauth-client-secret-here

# Optional: Telegram alerts for Discord disconnects and reconnects; set both or leave both empty.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

APP_DOMAIN=feedflow-yourname.duckdns.org
APP_BASE_URL=https://feedflow-yourname.duckdns.org

SESSION_SECRET=replace-with-a-long-random-string
WEBHOOK_ENCRYPTION_KEY=replace-with-a-fernet-key

DATABASE_PATH=/data/rssbot.sqlite3
POLL_SECONDS=10
DEFAULT_INTERVAL_SECONDS=300
DEV_GUILD_ID=
HOST=0.0.0.0
PORT=8000
